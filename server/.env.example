# ===== 部落活跃积分管理 后端配置 =====
# 复制本文件为 .env 并填写后启动

# 服务端口 (Nginx 反代到 127.0.0.1:3000)
PORT=3000

# MySQL 连接 (独立库 coc_points, 勿动 Typecho 库)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coc_app
DB_PASSWORD=改成强密码
DB_NAME=coc_points
DB_POOL=5

# 登录令牌签名密钥 (服务器上执行: openssl rand -hex 32)
JWT_SECRET=改成随机长字符串
TOKEN_EXPIRES=7d

# 管理员账号: 不再使用共享口令, 账号存在数据库 users 表里。
# 首次初始化(仅服务器本地执行, 交互式输入密码, 不写日志):
#   cd /opt/coc-points/server && npm run user:init-super-admin
# 忘记密码: npm run user:reset-password -- <username>

# 访客: 现在默认无需登录即可只读浏览(公开只读接口)。
# VIEWER_PASSWORD 仅用于可选的"访客口令登录"(POST /api/auth/viewer-login), 留空=关闭该入口。
VIEWER_PASSWORD=

# ===== 跨域 (CORS) =====
# 默认留空 = 关闭, 保持同源部署下的原有行为
#   (线上由 nginx 把 /api 反代到后端, 本地由 vite dev server 代理, 都不跨域)。
# 只有把**打包后的 H5 放到别的域名/机器**上, 让它直接请求本后端时才需要开:
#   CORS_ORIGINS=https://h5.example.com,http://localhost:8080
#   CORS_ORIGINS=*                      # 任意来源(本项目鉴权用 Authorization 头,
#                                       # 不用 Cookie, 因此不返回 Allow-Credentials)
# 配套的前端构建变量是 VITE_API_BASE(见 app/.env.example)。
CORS_ORIGINS=

# ===== Clash of Clans 官方 API (部落成员同步, 可选) =====
# 在 https://developer.clashofclans.com 用 CoC 账号登录创建 key, 并把**服务器出网 IP**加进允许列表
# (当前生产: <SERVER_IP>)。key 与 IP 绑定, 换 IP 需要重建 key。
# 只在服务端使用: 不下发前端、不写日志; 留空 = 关闭同步功能。
COC_API_TOKEN=
# 正常不用改; 仅本地测试桩服务时覆盖(例如 http://127.0.0.1:8099/v1)
# COC_API_BASE=https://api.clashofclans.com/v1

# ===== AI 创作工坊 (生图) =====
# 全部留空 = 不启用生图接口, 其余功能不受影响。
# 生图相关的非 GET 接口同样要求管理员(访客只能看图库)。

# 硅基流动 API Key (只放服务器, 绝不要写进前端)
SILICONFLOW_API_KEY=

# 生图模型与默认尺寸。
# Kwai-Kolors/Kolors 的推荐值: 1024x1024(1:1) 960x1280(3:4) 768x1024(3:4)
#                              720x1440(1:2) 720x1280(9:16)  <- 竖图可用
# 前端「东方幻境」可选方图/竖图, 这里只是默认值; 换模型(如 Qwen-Image 系列,
# 推荐 1328x1328 等)时必须同步核对文档, 否则启动会直接报错。
AI_IMAGE_MODEL=Kwai-Kolors/Kolors
AI_IMAGE_SIZE=1024x1024

# 平台自 2026-09-30 起默认给生成图加「AI 生成」水印。
# 本工坊要求出图无水印, 因此默认发送 X-Enable-Watermark: 0;
# 若你的账户策略要求保留水印, 设为 1。
AI_ENABLE_WATERMARK=0

# 是否发送 negative_prompt (Kolors 接口的正式字段), 默认 1。
# 换到不支持该字段的模型时设为 0。
AI_SEND_NEGATIVE_PROMPT=1

# 生成结果的可信图片域名, 多个用逗号分隔。必须填实际域名, 不要填 *
# 实测值就是 s3.siliconflow.cn (2026-09-10 用真实账号验证)
AI_IMAGE_DOWNLOAD_HOSTS=

# 图片存储目录, 必须位于 Nginx 静态根目录之外 (默认 /opt/coc-points/server/data/ai)
# ⚠️ 后端以 www-data 运行, 该目录必须 chown www-data 且可写,
#    否则启动会报 EACCES, 生图接口不会挂载:
#      mkdir -p /opt/coc-points/ai-storage
#      chown -R www-data:www-data /opt/coc-points/ai-storage && chmod 750 /opt/coc-points/ai-storage
AI_STORAGE_DIR=/opt/coc-points/ai-storage

# IP 与身份 HMAC 密钥, 至少 32 字符 (openssl rand -hex 32); 部署后保持稳定,
# 一旦更换, 所有人现有的本机图库命名空间会对不上(旧图仍可下载, 但"曾上传"标记会丢)
AI_IDENTITY_SECRET=

# 额度
# 每身份每日生成次数(按角色分档):
#   AI_DAILY_LIMIT        管理员上限; 0 = 不限制
#   AI_VIEWER_DAILY_LIMIT 非管理员(访客)上限
#   AI_GLOBAL_DAILY_LIMIT 全站每日上限, 所有角色合计(兜底防刷)
AI_DAILY_LIMIT=0
AI_VIEWER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=2000

# 非管理员每日上传张数(删除会释放名额, 不加日限可无限循环上传);
# 管理员不受此限制; 0 = 不限制
AI_VIEWER_UPLOAD_DAILY_LIMIT=10

# 未上传的临时生成图上限(张), 30 分钟过期
AI_TEMP_MAX_IMAGES=20
